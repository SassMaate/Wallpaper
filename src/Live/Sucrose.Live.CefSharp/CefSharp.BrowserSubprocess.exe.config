<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <!-- Force runtime to use .NET 9 location -->
            <dependentAssembly>
                <assemblyIdentity name="Microsoft.NETCore.App" />
                <bindingRedirect oldVersion="6.0.0.0-6.99.99.99" newVersion="9.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>

        <!-- Support for running on different .NET versions -->
        <supportedRuntime version="v9.0" sku=".NETCoreApp,Version=v9.0" />
        <supportedRuntime version="v6.0" sku=".NETCoreApp,Version=v6.0" />
    </runtime>

    <startup>
        <!-- Prefer .NET 9 runtime -->
        <supportedRuntime version="v9.0" sku=".NETCoreApp,Version=v9.0" />
    </startup>

    <!-- Application settings -->
    <appSettings>
        <add key="DOTNET_ROOT" value="..\Sucrose.Runtime" />
        <add key="DOTNET_MULTILEVEL_LOOKUP" value="0" />
    </appSettings>
</configuration>