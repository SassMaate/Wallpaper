<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sucrose.Portal.Controls">

    <Style TargetType="{x:Type controls:CustomGroupBox}">
        <Setter Property="BorderBrush" Value="Orange" />
        <Setter Property="Background" Value="#1a1a1a" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CustomGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Top border with header  -->
                        <Grid Grid.Row="0" Margin="0,0,0,-2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Top-left corner  -->
                            <Border
                                Grid.Column="0"
                                Width="8"
                                Height="2"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="8,0,0,0" />

                            <!--  Header  -->
                            <Border
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Padding="6,0"
                                Background="{TemplateBinding HeaderBackground}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>

                            <!--  Top-right border line  -->
                            <Border
                                Grid.Column="2"
                                Height="2"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="0,8,0,0" />
                        </Grid>

                        <!--  Main content border  -->
                        <Border
                            Grid.Row="1"
                            Padding="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2,0,2,2"
                            CornerRadius="0,0,8,8">
                            <ContentPresenter ContentSource="Content" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>