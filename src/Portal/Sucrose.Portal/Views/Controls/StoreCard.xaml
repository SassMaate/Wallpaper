<UserControl
    x:Class="Sucrose.Portal.Views.Controls.StoreCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Sucrose.Portal.ViewModels"
    xmlns:xag="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
    xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
    MinWidth="260"
    MinHeight="160"
    MaxWidth="400"
    MaxHeight="160"
    xf:Animations.Primary="{xf:Animate BasedOn={StaticResource Entered},
                                       Event=MouseEnter}"
    xf:Animations.Secondary="{xf:Animate BasedOn={StaticResource Leaved},
                                         Event=MouseLeave}"
    d:DataContext="{d:DesignInstance vm:StoreCardViewModel}"
    DataContextChanged="StoreCard_DataContextChanged"
    MouseEnter="StoreCard_MouseEnter"
    MouseLeave="StoreCard_MouseLeave"
    MouseLeftButtonUp="StoreCard_MouseLeftButtonUp"
    mc:Ignorable="d">

    <UserControl.ContextMenu>
        <ContextMenu
            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
            Opacity="0.9"
            Opened="ContextMenu_Opened">
            <ui:MenuItem
                Command="{Binding UpdateCommand}"
                Cursor="Hand"
                Header="{Binding UpdateHeader}"
                Icon="{ui:SymbolIcon BoxSearch24}"
                IsEnabled="{Binding CanUpdate}"
                Visibility="{Binding UpdateVisible, Converter={StaticResource BoolToVisibility}}" />
            <ui:MenuItem
                Command="{Binding InstallCommand}"
                Cursor="Hand"
                Header="{Binding InstallHeader}"
                Icon="{ui:SymbolIcon ImageAdd24}"
                IsEnabled="{Binding CanInstall}" />
            <ui:MenuItem
                Command="{Binding ReportCommand}"
                Cursor="Hand"
                Header="{DynamicResource Portal.StoreCard.MenuReport}"
                Icon="{ui:SymbolIcon PersonFeedback24}"
                IsEnabled="{Binding CanReport}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        CornerRadius="10">

        <Grid
            x:Name="CardClip"
            Background="Transparent"
            SizeChanged="CardClip_SizeChanged">

            <!-- Loading spinner (shown while cover/metadata is being fetched) -->
            <Border
                x:Name="Progress"
                Panel.ZIndex="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                CornerRadius="10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource ApplicationBackgroundColor}" />
                </Border.Background>
                <ui:ProgressRing
                    Width="120"
                    Height="120"
                    IsIndeterminate="True" />
            </Border>

            <!-- Error overlay (shown when cover/metadata cache download failed) -->
            <Border
                x:Name="Warn"
                Panel.ZIndex="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                CornerRadius="10"
                Visibility="{Binding IsLoadFailed, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource ApplicationBackgroundColor}" />
                </Border.Background>
                <ui:ProgressRing
                    Width="120"
                    Height="120"
                    Foreground="Crimson"
                    IsIndeterminate="False"
                    Progress="100" />
            </Border>

            <!-- Card content (thumbnail + info + download button) — hidden while loading
                 so the empty thumbnail/title/desc don't show; the ZIndex'd Progress/Warn
                 overlays sit on top. -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <!-- Static thumbnail — binding-driven (Rule 1) -->
                <Image
                    x:Name="Imagine"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="{Binding Thumbnail}"
                    Stretch="UniformToFill" />

                <!-- Hover GIF preview — starts Hidden, shown only after MediaOpened (Rule 3b) -->
                <Image
                    x:Name="Imaginer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    xag:AnimationBehavior.AnimateInDesignMode="False"
                    xag:AnimationBehavior.AutoStart="True"
                    xag:AnimationBehavior.CacheFramesInMemory="False"
                    xag:AnimationBehavior.RepeatBehavior="Forever"
                    xag:AnimationBehavior.SourceUri="{x:Null}"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Stretch="UniformToFill"
                    StretchDirection="Both"
                    Visibility="Hidden" />

                <!-- Info overlay -->
                <Border
                    x:Name="Preview"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    ClipToBounds="True"
                    CornerRadius="0,0,10,10">
                    <Border.Background>
                        <SolidColorBrush Opacity="0.75" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock
                            x:Name="ThemeTitle"
                            Grid.Row="0"
                            Margin="5,5,5,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Title}" />
                        <ui:TextBlock
                            x:Name="ThemeDescription"
                            Grid.Row="1"
                            Margin="5,0,5,5"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPlaceholderColorBrush}"
                            Text="{Binding Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Description}" />

                        <!-- Download button area (Rules 4 & 6) -->
                        <ui:Button
                            x:Name="Download"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="41.06"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Appearance="Transparent"
                            BorderBrush="Transparent"
                            Click="Download_Click"
                            Cursor="Hand"
                            ToolTip="{Binding DownloadPercentage}">
                            <Grid>
                                <!-- Incompatible version icon -->
                                <ui:SymbolIcon
                                    x:Name="IncompatibleVersion"
                                    Width="36"
                                    FontSize="36"
                                    Foreground="{DynamicResource PaletteRedBrush}"
                                    Symbol="BoxDismiss24"
                                    ToolTipService.ToolTip="{DynamicResource Portal.StoreCard.VersionTip}"
                                    Visibility="{Binding IsIncompatible, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Normal download symbol (shown when not incompatible, not downloading, not in error) -->
                                <ui:SymbolIcon
                                    x:Name="DownloadSymbol"
                                    Width="36"
                                    FontSize="36"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Symbol="CloudArrowDown24"
                                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Download-error icon -->
                                <ui:SymbolIcon
                                    x:Name="DownloadErrorSymbol"
                                    Width="36"
                                    FontSize="36"
                                    Foreground="{DynamicResource PaletteRedBrush}"
                                    Symbol="CloudDismiss24"
                                    Visibility="{Binding IsDownloadError, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Download-complete icon -->
                                <ui:SymbolIcon
                                    x:Name="DownloadCompleteSymbol"
                                    Width="36"
                                    FontSize="36"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Symbol="CloudCheckmark24"
                                    Visibility="{Binding IsDownloadComplete, Converter={StaticResource BoolToVisibility}}" />

                                <!-- In-progress ring -->
                                <ui:ProgressRing
                                    x:Name="DownloadRing"
                                    Width="36"
                                    Height="36"
                                    Progress="{Binding DownloadProgress}"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
