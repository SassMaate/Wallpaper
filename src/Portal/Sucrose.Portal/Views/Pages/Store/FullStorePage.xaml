<Page
    x:Class="Sucrose.Portal.Views.Pages.Store.FullStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sucrose.Portal.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Pages.Store"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vcontrols="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:vm="clr-namespace:Sucrose.Portal.ViewModels"
    Title="FullStorePage"
    d:DataContext="{d:DesignInstance local:FullStorePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Loaded="FullStorePage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Frame
            x:Name="Empty"
            Grid.Column="1"
            Visibility="Collapsed">
            <Frame.Content>
                <local:SearchStorePage />
            </Frame.Content>
        </Frame>

        <controls:SizeConstrainingContainer Grid.Column="0">
            <ui:NavigationView
                x:Name="CategoryView"
                Width="235"
                FrameMargin="0"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="False"
                MenuItemsSource="{Binding MenuItems, Mode=TwoWay}"
                OpenPaneLength="225"
                PaneDisplayMode="Left" />
        </controls:SizeConstrainingContainer>

        <ItemsControl
            x:Name="ThemeStore"
            Grid.Column="1"
            Margin="7,0,10,0"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <!--
                        Style="{x:Null}" opts this ScrollViewer OUT of wpfui's implicit
                        ScrollViewer style (Scroll.xaml). That implicit style retemplates the
                        ScrollViewer into a smooth pixel-scroller which forces
                        CanContentScroll=False and thereby DISABLES item virtualization. By
                        nulling the style we keep CanContentScroll=True so the panel's
                        IScrollInfo drives scrolling and UI virtualization stays engaged.
                    -->
                    <ScrollViewer
                        x:Name="PageScroll"
                        CanContentScroll="True"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        Style="{x:Null}"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:JustifiedVirtualizingWrapPanel
                        ItemHeight="160"
                        ItemMargin="{Binding CardMargin, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        ItemMaxWidth="400"
                        ItemMinWidth="260"
                        MaxItemsPerRow="{Binding CardsPerRow, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StoreCardViewModel}">
                    <vcontrols:StoreCard />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
