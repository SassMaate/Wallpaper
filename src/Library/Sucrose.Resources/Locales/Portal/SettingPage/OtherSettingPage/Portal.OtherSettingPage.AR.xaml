<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.OtherSettingPage.Title">OtherSettingPage</system:String>

    <system:String x:Key="Portal.OtherSettingPage.ReportData">الإبلاغ التلقائي عن الأخطاء</system:String>
    <system:String x:Key="Portal.OtherSettingPage.ReportData.Description">يتّخذ Sucrose إجراءً للإبلاغ عن الخطأ بسرعة عند مواجهته.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.StatisticsData">مشاركة إحصاءات الاستخدام</system:String>
    <system:String x:Key="Portal.OtherSettingPage.StatisticsData.Description">يتيح Sucrose جمع إحصاءات استخدامك للمساهمة في تطوير التطبيق.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.DiscordHook">Discord</system:String>
    <system:String x:Key="Portal.OtherSettingPage.DiscordHook.Description">يُسهّل Sucrose التواصل مع Discord.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.DiscordHook.DiscordDelay">فترة التحديث (ثوانٍ):</system:String>
    <system:String x:Key="Portal.OtherSettingPage.DiscordHook.DiscordRefresh">تحديث الاتصال:</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Agent">وكيل الإنترنت</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Agent.Description">هويتك في الحالات التي تتطلّب اتصالاً بالإنترنت.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Key">رمز الوصول الشخصي</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Key.Description">مطلوب للاستخدام السلس للمتجر وتحديثات التطبيق.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Key.HintKey">انقر هنا إذا كنت لا تعرف كيفية الحصول على رمز وصول شخصي.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Key.PersonalKey">يُرجى إدخال رمز وصول شخصي</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Key.PersonalKey.Valid">يُرجى إدخال رمز وصول شخصي صالح</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Server">خادم التحديث</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Server.Description">الخادم الذي ستُجرى التحديثات من خلاله.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Server.ServerHint">ملاحظة: إذا تم تحديد {0} كخادم، فإنك بحاجة إلى إدخال {2} لتجنّب حدود الطلبات. وإلا فقد تواجه مشكلات في التحديثات. وإذا تم تحديد {1}، فستحظى بتجربة تحديث أكثر سلاسة.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Module">وحدة التحديث</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Module.Description">الوحدة التي ستُستخدم لعملية التحديث.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Channel">قناة التحديث</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Channel.Description">القناة التي ستُجرى التحديثات من خلالها أو لن تُجرى.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Update">طريقة التحديث</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Update.Description">الطريقة المستخدمة لعملية التحديث.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Update.Limit">حدّ عرض نطاق التنزيل:</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Auto">التحديث التلقائي</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Auto.Description">ما إذا كان سيتم التحقّق من عملية التحديث تلقائيًا.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Auto.Update">كيف سيتم إجراء التحقّق:</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Developer">أدوات المطوّر</system:String>
    <system:String x:Key="Portal.OtherSettingPage.Developer.Description">إدارة أدوات المطوّر لمحرّك WebView وCefSharp.</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Developer.DeveloperMode">أدوات المطوّر الافتراضية:</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Developer.DeveloperPort">منفذ التصحيح:</system:String>

    <system:String x:Key="Portal.OtherSettingPage.Developer.DeveloperHint">تلميح: قد لا تعمل أدوات المطوّر الافتراضية بشكل صحيح في السِمات المدعومة. يميل منفذ التصحيح إلى العمل بشكل أفضل. عندما تكون جاهزًا، يمكنك استخدام العنوان 'http://localhost:{0}' أو 'chrome://inspect' لمتصفّح Chrome، و'opera://inspect' لمتصفّح Opera، و'edge://inspect' لمتصفّح Edge.</system:String>
</ResourceDictionary>