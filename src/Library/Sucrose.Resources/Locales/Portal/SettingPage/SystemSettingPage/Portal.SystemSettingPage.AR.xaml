<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.SystemSettingPage.Title">SystemSettingPage</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LogTemporary">ملفّات السجلّ</system:String>
    <system:String x:Key="Portal.SystemSettingPage.LogTemporary.Description">إدارة جميع ملفّات السجلّ التي ينشئها التطبيق.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LogTemporary.Create">إنشاء</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LogTemporary.Delete">مسح</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LogTemporary.Hint">ملاحظة: إجمالي المساحة التي تشغلها ملفّات السجلّ هو {0}. لن يتم إغلاق جميع التطبيقات إلا عند بدء التنظيف.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.CacheTemporary">مسح ذاكرة التخزين المؤقّت</system:String>
    <system:String x:Key="Portal.SystemSettingPage.CacheTemporary.Description">مسح جميع ملفّات ذاكرة التخزين المؤقّت التي أنشأها التطبيق.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.CacheTemporary.Start">بدء التنظيف</system:String>

    <system:String x:Key="Portal.SystemSettingPage.CacheTemporary.Hint">ملاحظة: إجمالي المساحة التي تشغلها ملفّات ذاكرة التخزين المؤقّت هو {0}. عند بدء التنظيف سيتم إغلاق جميع التطبيقات.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.StoreTemporary">مسح المتجر</system:String>
    <system:String x:Key="Portal.SystemSettingPage.StoreTemporary.Description">مسح جميع ملفّات المتجر التي أنشأها التطبيق.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.StoreTemporary.Start">بدء التنظيف</system:String>

    <system:String x:Key="Portal.SystemSettingPage.StoreTemporary.Hint">ملاحظة: إجمالي المساحة التي تشغلها ملفّات المتجر هو {0}. عند بدء التنظيف سيتم إغلاق جميع التطبيقات.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LibraryTemporary">مسح المكتبة</system:String>
    <system:String x:Key="Portal.SystemSettingPage.LibraryTemporary.Description">مسح جميع ملفّات السِمات في مكتبتك، سواء كانت في مكتبتك أو أنشأتها بنفسك.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LibraryTemporary.Start">بدء التنظيف</system:String>

    <system:String x:Key="Portal.SystemSettingPage.LibraryTemporary.Hint">ملاحظة: إجمالي المساحة التي تشغلها السِمات في مكتبتك هو {0}. عند بدء التنظيف سيتم إغلاق جميع التطبيقات.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingBackup">النسخ الاحتياطي للإعدادات</system:String>
    <system:String x:Key="Portal.SystemSettingPage.SettingBackup.Description">إدارة جميع ملفّات الإعدادات التي ينشئها التطبيق.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingBackup.Export">نسخ احتياطي</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingBackup.Import">استعادة</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingBackup.Hint">ملاحظة: سيتم إغلاق جميع التطبيقات عند بدء العملية المحدّدة.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingReset">إعادة تعيين الإعدادات</system:String>
    <system:String x:Key="Portal.SystemSettingPage.SettingReset.Description">إعادة تعيين جميع ملفّات الإعدادات التي ينشئها التطبيق.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingReset.Start">بدء إعادة التعيين</system:String>

    <system:String x:Key="Portal.SystemSettingPage.SettingReset.Hint">ملاحظة: سيتم إغلاق جميع التطبيقات عند بدء عملية إعادة التعيين.</system:String>

    <system:String x:Key="Portal.SystemSettingPage.Log.SaveDialogTitle">حفظ ملف السجلّ</system:String>
    <system:String x:Key="Portal.SystemSettingPage.Log.SaveDialogFilter">ملفّات ZIP (*.zip)|*.zip|جميع الملفّات (*.*)|*.*</system:String>

    <system:String x:Key="Portal.SystemSettingPage.Access.Close">حسنًا</system:String>
    <system:String x:Key="Portal.SystemSettingPage.Access.Title">تحذير الوصول</system:String>
    <system:String x:Key="Portal.SystemSettingPage.Access.Message">ليس لديك إذن للوصول إلى الموقع المحدّد.</system:String>
</ResourceDictionary>