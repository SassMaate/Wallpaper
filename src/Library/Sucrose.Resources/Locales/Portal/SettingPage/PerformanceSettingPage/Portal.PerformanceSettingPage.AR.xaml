<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.PerformanceSettingPage.Title">PerformanceSettingPage</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Counter">عدّادات الأداء</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Counter.Description">ما إذا كان ينبغي تشغيل جميع عدّادات الأداء في الخلفية.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Counter.CounterHint">ملاحظة: قد لا تعمل بعض السِمات من نوع Web بشكل صحيح، ولن يعمل أيٌّ من إعدادات الأداء أدناه.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Pause">قاعدة الإيقاف المؤقّت</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Pause.Description">تحدِّد قاعدة الإيقاف المؤقّت لخلفية الشاشة بناءً على إعدادات الأداء الخاصة بك.</system:String>

