<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.PerformanceSettingPage.Title">PerformanceSettingPage</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Counter">מוני ביצועים</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Counter.Description">האם כל מוני הביצועים יפעלו ברקע.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Counter.CounterHint">הערה: ייתכן שחלק מהערכות נושא מסוג אינטרנט לא יפעלו כראוי ואף אחת מהגדרות הביצועים שלהלן לא תעבוד.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Pause">כלל עצירה</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Pause.Description">קובע את הכלל להפסקת הטפט בהתבסס על הגדרות הביצועים שלך.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Communication">סוג איש קשר</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Communication.Description">זה קובע את סוג השליחה של הודעות שישודרו לנושאים מסוג אינטרנט.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Processor">שימוש במעבד</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Processor.Description">מה יקרה לטפט כתוצאה מהגדרות השימוש במעבד שלך.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Processor.ProcessorUsage">שימוש במעבד (%):</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Graphic">שימוש בכרטיס מסך</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Graphic.Description">מה יקרה לטפט כתוצאה מהגדרות השימוש בכרטיס המסך שלך.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Graphic.GraphicAdapter">כרטיס מסך:</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Graphic.GraphicAdapter.Empty">רשימת הכרטיסים הגרפיים עדיין לא נוצרה</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Graphic.GraphicUsage">שימוש בכרטיס מסך (%):</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Memory">שימוש בזיכרון</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Memory.Description">מה קורה לטפט כתוצאה מהגדרות השימוש בזיכרון שלך.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Memory.MemoryUsage">שימוש בזיכרון (%):</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Network">שימוש ברשת</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Network.Description">מה קורה לטפט כתוצאה מהגדרות השימוש ברשת שלך.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Network.NetworkAdapter">מתאם רשת:</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Network.NetworkAdapter.Empty">רשימת מתאמי הרשת לא נוצרה עדיין</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Network.NetworkUpload">גודל הורדה:</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Network.NetworkDownload">גודל הורדה:</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Network.NetworkPing">ערך פינג (MS):</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Lock">נעילת הפעלה</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Lock.Description">מה קורה לטפט כשההפעלה נעולה.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Sleep">מצב שינה</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Sleep.Description">מה קורה לטפט כשהמערכת במצב שינה.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Console">החלפת משתמש</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Console.Description">מה קורה לטפט כאשר מחליפים את המשתמש.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Session">התנתק</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Session.Description">מה קורה לטפט כאשר מתנתקים.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.ScreenSaver">מגן מסך</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.ScreenSaver.Description">מה קורה לטפט כאשר שומר המסך מופעל.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Battery">כוח סוללה</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Battery.Description">מה קורה לטפט כאשר המחשב הנייד פועל על סוללה.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Battery.BatteryUsage">מצב סוללה (%):</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.BatterySaver">חיסכון בסוללה</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.BatterySaver.Description">מה קורה לטפט כאשר המחשב הנייד נמצא במצב חיסכון בסוללה.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Virtual">וירטואליזציה</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Virtual.Description">מה קורה לטפטים כאשר יישומי וירטואליזציה פועלים.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Remote">שולחן עבודה מרוחק</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Remote.Description">מה קורה לטפט כאשר יישומי שולחן עבודה מרוחק פועלים.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.FullScreen">מצב מסך מלא</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.FullScreen.Description">מה קורה לטפט כאשר כל אפליקציה פועלת במסך מלא.</system:String>

    <system:String x:Key="Portal.PerformanceSettingPage.Focus">מצב פוקוס</system:String>
    <system:String x:Key="Portal.PerformanceSettingPage.Focus.Description">מה קורה לטפט כשיש לך כל אפליקציה אחרת בפוקוס.</system:String>
</ResourceDictionary>