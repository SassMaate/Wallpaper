<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.GeneralSettingPage.Title">GeneralSettingPage</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.ApplicationLanguage">لغة التطبيق</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationLanguage.Description">حدِّد اللغة التي تريد عرض التطبيق بها.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup">التشغيل عند بدء تشغيل التطبيق</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Description">يحتاج Sucrose إلى العمل في الخلفية عند بدء التشغيل لتشغيل خلفية الشاشة.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Startup.None">بلا</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Startup.Normal">عادي</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Startup.Priority">أولوية</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Startup.Scheduler">المجدوِل</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Warning.Close">حسنًا</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Warning.Title">تحذير صلاحيات المسؤول</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.ApplicationStartup.Warning.Message">تحتاج إلى صلاحيات المسؤول لتغيير حالة بدء التشغيل.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.NotifyIcon">أيقونة منطقة الإشعارات</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.NotifyIcon.Description">الظهور في علبة النظام. سيواصل Sucrose العمل بصورة خفيّة.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.NotifyIcon.Notify.Hide">غير مرئي</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.NotifyIcon.Notify.Show">مرئي</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.NotifyIcon.NotifyExit">إغلاق جميع تطبيقات Sucrose عند إغلاق علبة النظام</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop">خلفية النافذة</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.Description">تُستخدَم لتخصيص خلفية نافذة التطبيق.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackgroundImage.Lock">للأسف، ملف الصورة المحدَّد قيد الاستخدام من قِبل عملية أخرى</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackgroundImage.Title">تحديد صورة الخلفية</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackgroundImage.Access">للأسف، ليس لديك إذن للوصول إلى ملف الصورة المحدَّد</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackgroundImage.Filter">ملفّات الصور (*.png;*.jpg;*.jpeg;*.tiff;*.webp;*.gif)|*.png;*.jpg;*.jpeg;*.tiff;*.webp;*.gif</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackgroundImage.Select">حدِّد صورة خلفية</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackdropStretch">تمدّد الخلفية:</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.WindowBackdrop.BackdropOpacity">شفافية الخلفية (%):</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.EngineVolume">مستوى صوت المحرّك</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.EngineVolume.Description">مستوى الصوت المطبَّق على جميع خلفيات الشاشة.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.EngineVolume.VolumeActive">تشغيل الصوت فقط عندما تكون جميع التطبيقات صامتة</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.EngineVolume.VolumeDesktop">تشغيل الصوت فقط عند التركيز على سطح المكتب</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.EngineVolume.VolumeSensitivity">الحساسية (ثوانٍ):</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.PrivateLibrary">موقع المكتبة</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.PrivateLibrary.Description">الموقع الذي تُخزَّن فيه السِمات التي تضيفها إلى مكتبتك.</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.PrivateLibrary.LibraryLocation.Move">يُرجى الانتظار أثناء تغيير الموقع</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.PrivateLibrary.LibraryLocation.Empty">يُرجى تحديد مجلّد فارغ</system:String>
    <system:String x:Key="Portal.GeneralSettingPage.PrivateLibrary.LibraryLocation.Access">للأسف، ليس لديك وصول إلى الموقع الجديد</system:String>

    <system:String x:Key="Portal.GeneralSettingPage.PrivateLibrary.LibraryMove">نقل مكتبتك الحالية إلى الموقع الجديد</system:String>
</ResourceDictionary>