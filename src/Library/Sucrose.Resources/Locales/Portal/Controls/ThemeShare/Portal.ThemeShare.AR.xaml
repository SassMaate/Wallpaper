<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.ThemeShare.Close">إغلاق</system:String>
    <system:String x:Key="Portal.ThemeShare.Title">مشاركة السِمة</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemeTitle">العنوان</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemeDescription">الوصف</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemeCopy">نسخ الرابط</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemeExport">تصدير</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish">النشر في المتجر</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Publish">نشر</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Preparing">ستبدأ تحضيرات النشر بعد قليل..</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Limit">يجري التحقّق من حدّك اليومي لرفع السِمات..</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Limit.Error">حدث خطأ غير معروف أثناء التحقّق من حدّك اليومي لرفع السِمات.</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Limit.Exceeded">لقد وصلت إلى حدّك اليومي لرفع السِمات، يُرجى المحاولة مرة أخرى لاحقًا.</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Compress">يجري ضغط السِمة قبل رفعها..</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Compress.Error">حدث خطأ أثناء ضغط السِمة.</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Size">يجري التحقّق من حجم السِمة المضغوطة..</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Size.Exceeded">لا يمكن رفع السِمة المضغوطة لأنها تتجاوز {0} MB.</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Check">يجري التحقّق من سلامة السِمة المضغوطة قبل رفعها..</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Check.Error">حدث خطأ أثناء التحقّق من سلامة السِمة المضغوطة.</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Upload">يجري تحضير السِمة المضغوطة للرفع..</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Upload.Error">حدث خطأ غير معروف أثناء رفع السِمة المضغوطة.</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Upload.Start">يجري رفع السِمة المضغوطة..</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Upload.Errored">حدث خطأ غير متوقّع أثناء رفع السِمة المضغوطة: {0}.</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Upload.Succeded">تم رفع السِمة المضغوطة بنجاح، وسيتم نشرها في المتجر بعد التحقّق.</system:String>

    <system:String x:Key="Portal.ThemeShare.SaveDialogTitle">حفظ ملف السِمة</system:String>
    <system:String x:Key="Portal.ThemeShare.SaveDialogFilter">ملفّات ZIP (*.zip)|*.zip|كل الملفّات (*.*)|*.*</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Already.Close">حسنًا</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Already.Title">تحذير النشر</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Already.Message">السِمة المحدّدة مثبَّتة بالفعل من المتجر.</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemePublish.Premium.Close">حسنًا</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Premium.Title">تحذير النشر</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemePublish.Premium.Message">السِمة المحدّدة مثبَّتة بالفعل من المتجر المميَّز.</system:String>

    <system:String x:Key="Portal.ThemeShare.ThemeExport.Premium.Close">حسنًا</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemeExport.Premium.Title">تحذير التصدير</system:String>
    <system:String x:Key="Portal.ThemeShare.ThemeExport.Premium.Message">لا يمكن تصدير السِمة المحدّدة لأنها مثبَّتة من المتجر المميَّز.</system:String>
</ResourceDictionary>