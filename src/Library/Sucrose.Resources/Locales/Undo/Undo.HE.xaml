<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Undo.QuestionTitle">Sucrose Undo</system:String>

    <system:String x:Key="Undo.QuestionMessage">האם אתה באמת רוצה להסיר את ההתקנה של Sucrose Wallpaper Engine?</system:String>
    <system:String x:Key="Undo.QuestionDescription">אם אתה רוצה להסיר אותו עם כל ההגדרות שלו, בחר כן, אם אתה רוצה להסיר אותו על ידי שמירת ההגדרות, בחר לא, ואם אתה רוצה לבטל את תהליך ההסרה, אנא בחר ביטול.</system:String>
</ResourceDictionary>