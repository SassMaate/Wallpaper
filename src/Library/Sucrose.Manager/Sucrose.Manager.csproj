        <OutputPath Condition="'$(PlatformTarget)' == 'x86'">$(BaseOutputPath)\Library\Manager\x86</OutputPath>
        <OutputPath Condition="'$(PlatformTarget)' == 'x64'">$(BaseOutputPath)\Library\Manager\x64</OutputPath>
        <OutputPath Condition="'$(PlatformTarget)' == 'arm64'">$(BaseOutputPath)\Library\Manager\ARM64</OutputPath>
