<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <OutputType>Library</OutputType>
        <OutputPath Condition="'$(PlatformTarget)' == 'x86'">$(BaseOutputPath)\Library\XamlAnimatedGif\x86</OutputPath>
        <OutputPath Condition="'$(PlatformTarget)' == 'x64'">$(BaseOutputPath)\Library\XamlAnimatedGif\x64</OutputPath>
        <OutputPath Condition="'$(PlatformTarget)' == 'arm64'">$(BaseOutputPath)\Library\XamlAnimatedGif\ARM64</OutputPath>
    </PropertyGroup>

</Project>