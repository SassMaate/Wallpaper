<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <OutputType>Exe</OutputType>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>$(AssemblyName)</RootNamespace>
        <AssemblyName>Sucrose.Backgroundog</AssemblyName>
        <StartupObject>$(AssemblyName).App</StartupObject>
        <DefineConstants>$(DefineConstants);BACKGROUNDOG</DefineConstants>
        <OutputPath Condition="'$(PlatformTarget)' == 'x86'">$(BaseOutputPath)\Backgroundog\x86</OutputPath>
        <OutputPath Condition="'$(PlatformTarget)' == 'x64'">$(BaseOutputPath)\Backgroundog\x64</OutputPath>
        <OutputPath Condition="'$(PlatformTarget)' == 'arm64'">$(BaseOutputPath)\Backgroundog\ARM64</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
        <AppHostDotnetRoot>..\Sucrose.Runtime</AppHostDotnetRoot>
        <AppHostRelativeDotNet>..\Sucrose.Runtime</AppHostRelativeDotNet>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NAudio" />
        <PackageReference Include="NPSMLib" />
        <PackageReference Include="Skylark.Wing" />
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="Skylark.Standard" />
        <PackageReference Include="LibreHardwareMonitorLib" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Library\Sucrose.Pipe\Sucrose.Pipe.csproj" />
        <ProjectReference Include="..\..\Library\Sucrose.Signal\Sucrose.Signal.csproj" />
        <ProjectReference Include="..\..\Library\Sucrose.Manager\Sucrose.Manager.csproj" />
        <ProjectReference Include="..\..\Library\Sucrose.Transmission\Sucrose.Transmission.csproj" />
    </ItemGroup>

    <Import Project="..\..\Shared\Sucrose.Shared.Live\Sucrose.Shared.Live.projitems" Label="Shared" />
    <Import Project="..\..\Shared\Sucrose.Shared.Space\Sucrose.Shared.Space.projitems" Label="Shared" />
    <Import Project="..\..\Shared\Sucrose.Shared.Theme\Sucrose.Shared.Theme.projitems" Label="Shared" />
    <Import Project="..\..\Shared\Sucrose.Shared.Watchdog\Sucrose.Shared.Watchdog.projitems" Label="Shared" />
    <Import Project="..\..\Shared\Sucrose.Shared.Dependency\Sucrose.Shared.Dependency.projitems" Label="Shared" />

</Project>